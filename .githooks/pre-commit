#!/bin/sh
# Quick checks before each commit. Tests run in CI.
# Turn on once per clone: git config core.hooksPath .githooks
# Skip once (not recommended): git commit --no-verify

echo "pre-commit: checking formatting..."
if ! dart format --output=none --set-exit-if-changed lib test >/dev/null; then
  echo "Some files are not formatted. Run: dart format lib test" >&2
  exit 1
fi

echo "pre-commit: analyzing..."
if ! flutter analyze --no-pub; then
  echo "Fix the problems above, then commit again." >&2
  exit 1
fi
